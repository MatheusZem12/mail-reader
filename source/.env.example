# Configuração OAuth do Mail Reader — VOCÊ NÃO PRECISA EDITAR ESTE ARQUIVO.
#
# No primeiro acesso o próprio app abre a tela "Configurar OAuth" com tutorial:
# você cola os códigos lá e ele cria/atualiza o .env desta máquina sozinho.
#
# Este arquivo existe só como referência das variáveis usadas (e para quem
# preferir preencher manualmente: copie para .env e edite).
#
# O .env é LOCAL e está no .gitignore — nunca commite suas credenciais.
# Em outro computador: copie seu .env para lá, ou cole os códigos de novo no app.

# Google Cloud → Credentials → OAuth client ID → tipo "Desktop app"
# O ID termina em .apps.googleusercontent.com; o "secret" começa com GOCSPX-
MAIL_READER_GOOGLE_CLIENT_ID=
MAIL_READER_GOOGLE_CLIENT_SECRET=

# Azure → App registrations → Application (client) ID
MAIL_READER_MICROSOFT_CLIENT_ID=
